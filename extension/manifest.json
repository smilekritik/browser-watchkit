{
  "manifest_version": 3,
  "name": "WatchKit",
  "version": "1.5.2",
  "key": "",
  "description": "Show what you are watching or listening to in Chrome on Discord.",
  "minimum_chrome_version": "119",
  "incognito": "not_allowed",
  "permissions": ["activeTab", "storage", "scripting", "nativeMessaging", "webNavigation"],
  "optional_host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "commands": {
    "toggle-sharing": {
      "suggested_key": { "default": "Ctrl+Shift+Y" },
      "description": "Toggle WatchKit tracking"
    }
  }
}

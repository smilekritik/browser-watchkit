{
  "manifest_version": 3,
  "name": "WatchKit",
  "version": "0.1.0",
  "key": "",
  "description": "Show the video playing in your active tab as Discord Rich Presence.",
  "minimum_chrome_version": "119",
  "incognito": "not_allowed",
  "permissions": ["activeTab", "storage", "scripting", "nativeMessaging", "webNavigation"],
  "optional_host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html" },
  "options_page": "popup.html"
}
